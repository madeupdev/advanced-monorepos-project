{
  "name": "@madeup-video/storefront",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "nx next:dev",
    "build": "pnpm db:generate && nx next:build",
    "start": "nx next:start",
    "lint": "eslint .",
    "typecheck": "pnpm db:generate && next typegen && tsc --noEmit",
    "test": "pnpm test:all",
    "test:all": "pnpm test:tooling && pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:tooling": "node --test tests/tooling/**/*.test.mjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "tsx tests/helpers/prepare-test-database.ts && vitest run --project integration",
    "test:e2e": "tsx tests/helpers/prepare-test-database.ts && nx e2e",
    "db:start": "node scripts/db-start.mjs",
    "db:stop": "node scripts/db-stop.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:config": "node scripts/db-config.mjs",
    "db:logs": "node scripts/db-logs.mjs",
    "db:status": "node scripts/db-status.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "pnpm db:generate && prisma db seed"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "dotenv": "^17.4.2",
    "next": "16.2.9",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nx/next": "23.1.1",
    "@nx/playwright": "23.1.1",
    "@playwright/test": "1.62.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.9",
    "nx": "23.1.1",
    "prisma": "7.7.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "vitest": "4.1.7"
  }
}
