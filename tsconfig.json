{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@madeup-video/contracts": ["./libs/contracts/src/index.ts"],
      "@madeup-video/database": ["./libs/database/src/index.ts"],
      "@madeup-video/rental-domain": ["./libs/rental-domain/src/index.ts"],
      "@madeup-video/testing": ["./libs/testing/src/index.ts"],
      "@madeup-video/ui": ["./libs/ui/src/index.ts"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
